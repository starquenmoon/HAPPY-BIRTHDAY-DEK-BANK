                cardMsg2: "ขอให้ได้กินของอร่อยๆ ทุกวัน ไม่มีความเครียดเข้ามากล้ำกราย!",
                cardMsg3: "เธอกำลังเติบโตขึ้นอย่างงดงาม เค้าภูมิใจในตัวเธอเสมอนะ!"
            }
        };

        const defaultConfig = {
            ...presets.romantic,
            images: [
                "https://images.unsplash.com/photo-1513151233558-d860c5398176?auto=format&fit=crop&w=800&q=80",
                "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=800&q=80",
                "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=800&q=80",
                "https://images.unsplash.com/photo-1464349095431-e9a21285b5f3?auto=format&fit=crop&w=800&q=80"
            ]
        };

        let appConfig = { ...defaultConfig };
        let currentSlide = 0;
        let isAudioPlaying = false;
        let audioCtx = null;

        // Initialize Web Audio API
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playPopSound() {
            try {
                initAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1200, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1);
            } catch (e) { console.log('Audio play error', e); }
        }

        function playCelebrateSound() {
            try {
                initAudio();
                const notes = [261.63, 329.63, 392.00, 523.25];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime + idx * 0.1);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + idx * 0.1 + 0.3);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + idx * 0.1);
                    osc.stop(audioCtx.currentTime + idx * 0.1 + 0.3);
                });
            } catch (e) { console.log('Audio play error', e); }
        }

        // Synth BGM Loop
        const melodyNotes = [
            { f: 264, d: 0.4 }, { f: 264, d: 0.4 }, { f: 297, d: 0.8 }, { f: 264, d: 0.8 }, { f: 352, d: 0.8 }, { f: 330, d: 1.2 },
            { f: 264, d: 0.4 }, { f: 264, d: 0.4 }, { f: 297, d: 0.8 }, { f: 264, d: 0.8 }, { f: 396, d: 0.8 }, { f: 352, d: 1.2 }
        ];

        function toggleBGM() {
            initAudio();
            const bgmBtn = document.getElementById('bgm-toggle');
            const bgmIcon = document.getElementById('bgm-icon');

            if (isAudioPlaying) {
                isAudioPlaying = false;
                bgmIcon.className = "fas fa-music text-lg";
                bgmBtn.classList.remove('animate-bounce');
            } else {
                isAudioPlaying = true;
                bgmIcon.className = "fas fa-volume-up text-lg text-pink-600";
                bgmBtn.classList.add('animate-bounce');
                playMelodyLoop();
            }
        }

        function playMelodyLoop(index = 0) {
            if (!isAudioPlaying) return;
            const note = melodyNotes[index % melodyNotes.length];
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.value = note.f;
            gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + note.d);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + note.d);

            setTimeout(() => {
                if (isAudioPlaying) {
                    playMelodyLoop(index + 1);
                }
            }, note.d * 1000 + 100);
        }

        function createFloatingHearts() {
            const container = document.getElementById('hearts-container');
            const hearts = ['💖', '💕', '🩵', '🌸', '☁️', '✨', '🎂', '🎉', '⭐'];
            for (let i = 0; i < 22; i++) {
                const heart = document.createElement('div');
                heart.className = 'absolute text-xl opacity-40 transition-all duration-1000 pointer-events-none';
                heart.innerText = hearts[Math.floor(Math.random() * hearts.length)];
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.top = Math.random() * 100 + 'vh';
                heart.style.animation = `float ${3 + Math.random() * 3}s ease-in-out infinite`;
                heart.style.animationDelay = `${Math.random() * 2}s`;
                container.appendChild(heart);
            }
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }

        function extinguishCandle(flameElement) {
            if (flameElement.classList.contains('extinguished')) return;
            flameElement.classList.add('extinguished');
            playPopSound();

            const smoke = document.createElement('div');
            smoke.className = 'smoke';
            flameElement.parentElement.appendChild(smoke);
            setTimeout(() => smoke.remove(), 1500);

            checkCandlesState();
        }

        function blowOutAllCandles() {
            const flames = document.querySelectorAll('.flame');
            flames.forEach(flame => {
                if (!flame.classList.contains('extinguished')) {
                    extinguishCandle(flame);
                }
            });
        }

        function relightCandles() {
            const flames = document.querySelectorAll('.flame');
            flames.forEach(flame => flame.classList.remove('extinguished'));
            document.getElementById('rekindle-btn').classList.add('hidden');
            document.getElementById('wish-message').classList.add('opacity-0');
        }

        function checkCandlesState() {
            const unlit = document.querySelectorAll('.flame:not(.extinguished)');
            if (unlit.length === 0) {
                triggerConfetti();
                playCelebrateSound();
                document.getElementById('rekindle-btn').classList.remove('hidden');
                document.getElementById('wish-message').classList.remove('opacity-0');
            }
        }

        function updateCounter() {
            const now = new Date();
            let currentYear = now.getFullYear();
            
            // Set target birthday date (October 9th)
            let bday = new Date(appConfig.startDate);
            let bdayMonth = isNaN(bday.getTime()) ? 9 : bday.getMonth(); // Default Oct (index 9)
            let bdayDay = isNaN(bday.getTime()) ? 9 : bday.getDate();     // Default 9th
            
            let targetDate = new Date(currentYear, bdayMonth, bdayDay, 0, 0, 0);
            
            // If birthday has passed this year, count down to next year
            if (now.getTime() > targetDate.getTime() + (24 * 60 * 60 * 1000)) {
                targetDate.setFullYear(currentYear + 1);
            }

            const diff = targetDate.getTime() - now.getTime();

            if (diff <= 0 && Math.abs(diff) < 24 * 60 * 60 * 1000) {
                // Today is the birthday!
                document.getElementById('days-count').innerText = "0";
                document.getElementById('hours-count').innerText = "0";
                document.getElementById('minutes-count').innerText = "0";
                document.getElementById('seconds-count').innerText = "0";
                document.getElementById('counter-subtitle').innerText = "🎉 วันนี้เป็นวันเกิดแล้ว! ขอให้มีความสุขมากๆ นะครับ 💖";
                return;
            }

            const absDiff = Math.abs(diff);
            const days = Math.floor(absDiff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((absDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((absDiff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((absDiff % (1000 * 60)) / 1000);

            document.getElementById('days-count').innerText = days;
            document.getElementById('hours-count').innerText = hours;
            document.getElementById('minutes-count').innerText = minutes;
            document.getElementById('seconds-count').innerText = seconds;
        }

        function renderGallery() {
            const container = document.getElementById('gallery-container');
            const dotsContainer = document.getElementById('gallery-dots');
            container.innerHTML = '';
            dotsContainer.innerHTML = '';

            appConfig.images.forEach((imgUrl, index) => {
                const slide = document.createElement('div');
                slide.className = `absolute inset-0 transition-all duration-700 transform ${index === currentSlide ? 'opacity-100 scale-100' : 'opacity-0 scale-95 pointer-events-none'}`;
                slide.innerHTML = `
                    <img src="${imgUrl}" alt="dek bank ${index + 1}" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/800x600/fce7f3/ec4899?text=dek+bank+Photo+${index + 1}'">
                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/80 via-slate-900/40 to-transparent p-4 text-white text-center text-sm font-medium">
                        ✨ dek bank - ความทรงจำรูปที่ ${index + 1}
                    </div>
                `;
                container.appendChild(slide);

                const dot = document.createElement('button');
                dot.className = `w-3 h-3 rounded-full transition-all ${index === currentSlide ? 'bg-pink-500 w-6' : 'bg-pink-200'}`;
                dot.onclick = () => goToSlide(index);
                dotsContainer.appendChild(dot);
            });
        }

        // Handle Direct Local Photo Upload
        function handleImageUpload(event) {
            const files = event.target.files;
            if (!files || files.length === 0) return;

            const newImages = [];
            let loadedCount = 0;

            Array.from(files).forEach((file, idx) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    newImages[idx] = e.target.result;
                    loadedCount++;

                    if (loadedCount === files.length) {
                        appConfig.images = newImages;
                        currentSlide = 0;
                        try {
                            localStorage.setItem('hbd_config', JSON.stringify(appConfig));
                        } catch (err) {
                            console.warn("LocalStorage space limit, stored in session memory.");
                        }
                        renderGallery();
                        playCelebrateSound();
                        triggerConfetti();
                    }
                };
                reader.readAsDataURL(file);
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % appConfig.images.length;
            renderGallery();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + appConfig.images.length) % appConfig.images.length;
            renderGallery();
        }

        function goToSlide(index) {
            currentSlide = index;
            renderGallery();
        }

