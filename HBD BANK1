        function applyPreset(presetKey) {
            if (presets[presetKey]) {
                const selected = presets[presetKey];
                document.getElementById('input-name').value = selected.name;
                document.getElementById('input-date').value = selected.startDate;
                document.getElementById('input-subtitle').value = selected.subtitle;
                document.getElementById('input-msg-1').value = selected.cardMsg1;
                document.getElementById('input-msg-2').value = selected.cardMsg2;
                document.getElementById('input-msg-3').value = selected.cardMsg3;
                playPopSound();
            }
        }

        function setupInlineEditing() {
            const displayName = document.getElementById('display-name');
            const heroSubtitle = document.getElementById('hero-subtitle');
            const cardMsg1 = document.getElementById('card-msg-1');
            const cardMsg2 = document.getElementById('card-msg-2');
            const cardMsg3 = document.getElementById('card-msg-3');

            const saveInlineChanges = () => {
                appConfig.name = displayName.innerText;
                appConfig.subtitle = heroSubtitle.innerText;
                appConfig.cardMsg1 = cardMsg1.innerText;
                appConfig.cardMsg2 = cardMsg2.innerText;
                appConfig.cardMsg3 = cardMsg3.innerText;
                localStorage.setItem('hbd_config', JSON.stringify(appConfig));
            };

            [displayName, heroSubtitle, cardMsg1, cardMsg2, cardMsg3].forEach(el => {
                el.addEventListener('blur', saveInlineChanges);
            });
        }

        function openSettings() {
            document.getElementById('input-name').value = appConfig.name;
            document.getElementById('input-date').value = appConfig.startDate;
            document.getElementById('input-subtitle').value = appConfig.subtitle;
            document.getElementById('input-msg-1').value = appConfig.cardMsg1;
            document.getElementById('input-msg-2').value = appConfig.cardMsg2;
            document.getElementById('input-msg-3').value = appConfig.cardMsg3;
            document.getElementById('input-images').value = appConfig.images.join(', ');

            const modal = document.getElementById('settings-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeSettings() {
            const modal = document.getElementById('settings-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        function saveSettings() {
            appConfig.name = document.getElementById('input-name').value || defaultConfig.name;
            appConfig.startDate = document.getElementById('input-date').value || defaultConfig.startDate;
            appConfig.subtitle = document.getElementById('input-subtitle').value || defaultConfig.subtitle;
            appConfig.cardMsg1 = document.getElementById('input-msg-1').value || defaultConfig.cardMsg1;
            appConfig.cardMsg2 = document.getElementById('input-msg-2').value || defaultConfig.cardMsg2;
            appConfig.cardMsg3 = document.getElementById('input-msg-3').value || defaultConfig.cardMsg3;

            const imgsRaw = document.getElementById('input-images').value;
            appConfig.images = imgsRaw.split(',').map(s => s.trim()).filter(s => s.length > 0);
            if (appConfig.images.length === 0) appConfig.images = [...defaultConfig.images];

            localStorage.setItem('hbd_config', JSON.stringify(appConfig));

            applyConfigToUI();
            closeSettings();
            playCelebrateSound();
        }

        function resetSettings() {
            appConfig = { ...defaultConfig };
            localStorage.removeItem('hbd_config');
            applyConfigToUI();
            closeSettings();
        }

        window.addEventListener('DOMContentLoaded', () => {
            const saved = localStorage.getItem('hbd_config');
            if (saved) {
                try { appConfig = JSON.parse(saved); } catch (e) {}
            }

            createFloatingHearts();
            applyConfigToUI();
            setupInlineEditing();
            setInterval(updateCounter, 1000);

            // Gift Box Unwrapping Handler
            document.getElementById('gift-box-btn').addEventListener('click', () => {
                const splash = document.getElementById('splash-screen');
                const main = document.getElementById('main-content');
                
                playCelebrateSound();
                triggerConfetti();

                splash.classList.add('opacity-0');
                setTimeout(() => {
                    splash.style.display = 'none';
                    main.classList.remove('opacity-0');
                }, 1000);

                toggleBGM();
            });

            // Settings Modal Listeners
            document.getElementById('close-settings').addEventListener('click', closeSettings);
            document.getElementById('save-settings-btn').addEventListener('click', saveSettings);
            document.getElementById('reset-settings-btn').addEventListener('click', resetSettings);
            document.getElementById('bgm-toggle').addEventListener('click', toggleBGM);
        });
    </script>
</body>
</html>
