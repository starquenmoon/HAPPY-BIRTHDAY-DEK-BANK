<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สุขสันต์วันเกิดนะคนเก่ง! 🎉💖</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Prompt & Mitr for modern Thai typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500;600&family=Prompt:wght@300;400;500;600;700&family=Sacramento&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Canvas-Confetti library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        softBlue: '#BAE6FD',
                        skyBlue: '#38BDF8',
                        deepBlue: '#0284C7',
                        iceBlue: '#E0F2FE',
                        softPink: '#FCE7F3',
                        pastelPink: '#F472B6',
                        rosePink: '#EC4899',
                        creamCard: '#FFFBFA',
                        warmCream: '#FFF8E7',
                        lightCream: '#FAF0E6',
                        softAmber: '#FCD34D'
                    },
                    fontFamily: {
                        prompt: ['Prompt', 'sans-serif'],
                        mitr: ['Mitr', 'sans-serif'],
                        cursive: ['Sacramento', 'cursive']
                    },
                    animation: {
                        'bounce-slow': 'bounce 2s infinite',
                        'float': 'float 3s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 2s infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-12px)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { filter: 'drop-shadow(0 0 15px rgba(244,114,182,0.6))' },
                            '50%': { filter: 'drop-shadow(0 0 25px rgba(56,189,248,0.9))' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background: linear-gradient(135deg, #FFF0F5 0%, #FFF8E7 35%, #E0F2FE 70%, #FCE7F3 100%);
            min-height: 100vh;
            overflow-x: hidden;
            user-select: none;
        }

        /* Candle Flame Animation */
        .flame {
            width: 14px;
            height: 24px;
            background: linear-gradient(to bottom, #FFF 0%, #FFD700 40%, #FF4500 100%);
            border-radius: 50% 50% 20% 20%;
            box-shadow: 0 0 15px #FFD700, 0 0 25px #FF4500;
            animation: flicker 0.15s ease-in-out infinite alternate;
            transform-origin: center bottom;
            cursor: pointer;
        }

        @keyframes flicker {
            0% { transform: scale(1) rotate(-2deg); }
            100% { transform: scale(1.1) rotate(2deg); }
        }

        .flame.extinguished {
            display: none;
        }

        .smoke {
            position: absolute;
            width: 6px;
            height: 20px;
            background: rgba(200, 200, 200, 0.6);
            border-radius: 10px;
            animation: rise 1.5s ease-out forwards;
        }

        @keyframes rise {
            0% { opacity: 0.8; transform: translateY(0) scaleX(1); }
            100% { opacity: 0; transform: translateY(-40px) scaleX(2.5); filter: blur(4px); }
        }

        /* Glassmorphism Effect */
        .glass-card {
            background: rgba(255, 253, 250, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(252, 231, 243, 0.8);
        }

        /* Flip Card Effect */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Inline Editable Focus Highlight */
        [contenteditable="true"]:hover {
            outline: 2px dashed #EC4899;
            border-radius: 6px;
            cursor: text;
        }
        [contenteditable="true"]:focus {
            outline: 2px solid #EC4899;
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 6px;
            color: #1E293B;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFF0F5;
        }
        ::-webkit-scrollbar-thumb {
            background: #F472B6;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #EC4899;
        }
    </style>
</head>
<body class="text-gray-800 antialiased relative selection:bg-pink-200">

    <!-- Floating Hearts & Sparkles Particle Background -->
    <div id="hearts-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden"></div>

    <!-- Quick Floating Action Buttons -->
    <div class="fixed top-4 right-4 z-40 flex items-center gap-2 md:gap-3">
        <!-- Edit Mode Toggle Indicator -->
        <button id="quick-edit-btn" onclick="openSettings()" class="glass-card px-4 py-2.5 rounded-full text-pink-600 hover:bg-pink-500 hover:text-white transition-all duration-300 shadow-lg flex items-center gap-2 text-xs md:text-sm font-semibold border border-pink-200">
            <i class="fas fa-pen-to-square text-base"></i>
            <span>แก้ไขข้อความ</span>
        </button>

        <!-- BGM Toggle Button -->
        <button id="bgm-toggle" class="glass-card p-3 rounded-full text-sky-600 hover:text-pink-600 hover:scale-110 transition-all duration-300 shadow-md flex items-center justify-center w-11 h-11 border border-pink-200" title="เปิด/ปิด เสียงเพลง">
            <i id="bgm-icon" class="fas fa-music text-lg"></i>
        </button>
    </div>

    <!-- COVER / SPLASH SCREEN OVERLAY -->
    <div id="splash-screen" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-gradient-to-br from-pink-100 via-amber-50 to-sky-100 px-4 transition-opacity duration-1000">
        <div class="text-center max-w-md mx-auto animate-float">
            <div class="inline-block p-4 rounded-full bg-white/80 backdrop-blur-md mb-6 shadow-xl border border-pink-100">
                <span class="text-6xl animate-pulse">🎁</span>
            </div>
            <h1 id="splash-title" class="text-3xl md:text-4xl font-bold text-pink-600 mb-3 font-mitr">มีของขวัญพิเศษรออยู่นะ!</h1>
            <p id="splash-subtext" class="text-gray-600 mb-8 text-base md:text-lg">คลิกที่กล่องของขวัญเพื่อเปิดเซอร์ไพรส์วันเกิด 💖🩵</p>
            
            <!-- Interactive Gift Box Icon -->
            <div id="gift-box-btn" class="relative group cursor-pointer inline-block transform hover:scale-105 transition-all duration-300">
                <div class="w-36 h-36 md:w-44 md:h-44 bg-gradient-to-tr from-pink-300 via-sky-300 to-amber-200 rounded-3xl shadow-2xl flex items-center justify-center relative overflow-hidden border-4 border-white group-hover:shadow-pink-300/80">
                    <!-- Ribbon vertical -->
                    <div class="absolute w-8 h-full bg-creamCard/90 top-0 left-1/2 -translate-x-1/2 border-x border-pink-200"></div>
                    <!-- Ribbon horizontal -->
                    <div class="absolute h-8 w-full bg-creamCard/90 top-1/2 -translate-y-1/2 left-0 border-y border-pink-200"></div>
                    <!-- Bow on top -->
                    <div class="absolute top-2 text-3xl md:text-4xl filter drop-shadow-md">🎀</div>
                    <!-- Heart Icon -->
                    <i class="fas fa-heart text-pink-500 text-3xl md:text-4xl z-10 animate-ping opacity-90"></i>
                </div>
                <p class="mt-4 text-sm font-semibold text-pink-600 bg-white/90 py-2 px-5 rounded-full shadow-md border border-pink-200">
                    ✨ แตะที่นี่เพื่อเปิดเลย! ✨
                </p>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT CONTAINER -->
    <main id="main-content" class="container mx-auto px-4 py-8 max-w-4xl relative z-10 opacity-0 transition-opacity duration-1000 min-h-screen flex flex-col justify-between">
        
        <!-- HEADER HERO SECTION -->
        <header class="text-center my-6 md:my-10">
            <div class="inline-block px-4 py-1.5 bg-pink-100/80 rounded-full text-pink-700 text-sm font-medium mb-3 border border-pink-200 shadow-sm">
                🎂 Happy Birthday Special Page
            </div>
            <h1 class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-500 via-sky-500 to-amber-500 font-mitr tracking-tight mb-2">
                HAPPY BIRTHDAY <span id="display-name" contenteditable="true" title="คลิกเพื่อแก้ไขชื่อตรงนี้ได้เลย">dek bank</span> 🎉
            </h1>
            <p id="hero-subtitle" contenteditable="true" title="คลิกเพื่อแก้ไขคำอวยพรตรงนี้ได้เลย" class="text-gray-600 text-base md:text-lg max-w-xl mx-auto mt-3 leading-relaxed px-2">
                ขอให้มีความสุขมากๆ มีรอยยิ้มที่สดใสในทุกๆ วัน เป็นคนเก่งและน่ารักแบบนี้ตลอดไปนะ💖🩵
            </p>
            <div class="mt-2 text-xs text-pink-500 italic opacity-80">
                <i class="fas fa-info-circle"></i> ข้อความที่มีเส้นใต้ หรือคลิกแล้วพิมพ์เปลี่ยนข้อความได้ทันที
            </div>
        </header>

        <!-- SECTION 1: INTERACTIVE BIRTHDAY CAKE -->
        <section class="my-6 glass-card rounded-3xl p-6 md:p-8 shadow-xl text-center relative overflow-hidden border border-white">
            <h2 class="text-2xl md:text-3xl font-bold text-pink-600 mb-2 font-mitr">🎂 อธิษฐานแล้วเป่าเทียนกันนะ!</h2>
            <p class="text-sm md:text-base text-gray-500 mb-6">คลิกที่เปลวไฟเทียนเพื่อเป่าเค้ก หรือกดปุ่มเป่าเทียนด้านล่าง</p>

            <!-- Cake Container -->
            <div class="relative w-64 md:w-80 h-64 mx-auto my-4 flex flex-col items-center justify-end">
                
                <!-- Candles Grid -->
                <div id="candles-container" class="flex justify-center gap-4 mb-1 z-20">
                    <!-- Candle 1 -->
                    <div class="candle flex flex-col items-center relative">
                        <div class="flame" onclick="extinguishCandle(this)"></div>
                        <div class="w-3 h-12 bg-gradient-to-b from-pink-200 to-pink-400 rounded-t-sm shadow-inner"></div>
                    </div>
                    <!-- Candle 2 -->
                    <div class="candle flex flex-col items-center relative">
                        <div class="flame" onclick="extinguishCandle(this)"></div>
                        <div class="w-3 h-14 bg-gradient-to-b from-amber-200 to-amber-300 rounded-t-sm shadow-inner"></div>
                    </div>
                    <!-- Candle 3 -->
                    <div class="candle flex flex-col items-center relative">
                        <div class="flame" onclick="extinguishCandle(this)"></div>
                        <div class="w-3 h-12 bg-gradient-to-b from-sky-200 to-sky-400 rounded-t-sm shadow-inner"></div>
                    </div>
                </div>

                <!-- Cake Tier Top -->
                <div class="w-40 md:w-48 h-16 bg-gradient-to-r from-pink-200 via-amber-100 to-sky-200 rounded-t-2xl relative shadow-md flex items-center justify-center border-b-4 border-pink-300">
                    <div class="absolute -bottom-2 w-full flex justify-around px-1">
                        <div class="w-6 h-4 bg-white rounded-b-full"></div>
                        <div class="w-8 h-6 bg-white rounded-b-full"></div>
                        <div class="w-6 h-3 bg-white rounded-b-full"></div>
                        <div class="w-7 h-5 bg-white rounded-b-full"></div>
                    </div>
                    <span class="text-xs text-pink-600 font-semibold tracking-wider">MAKE A WISH</span>
                </div>

                <!-- Cake Tier Bottom -->
                <div class="w-56 md:w-64 h-24 bg-gradient-to-r from-pink-300 via-sky-300 to-pink-300 rounded-t-xl relative shadow-lg flex items-center justify-center">
                    <div class="text-white text-xl font-bold font-cursive tracking-widest">Happy Birthday</div>
                    <div class="absolute top-1 left-4 text-sm">🍓</div>
                    <div class="absolute top-1 right-4 text-sm">🫐</div>
                    <div class="absolute top-1 left-1/2 -translate-x-1/2 text-sm">✨</div>
                </div>

                <!-- Cake Plate -->
                <div class="w-64 md:w-72 h-4 bg-amber-100 rounded-full shadow-md border-b-2 border-amber-200"></div>
            </div>

            <!-- Cake Actions -->
            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <button id="blow-btn" onclick="blowOutAllCandles()" class="bg-gradient-to-r from-pink-500 via-rosePink to-sky-500 text-white font-semibold px-6 py-2.5 rounded-full shadow-lg hover:shadow-pink-300/80 hover:scale-105 active:scale-95 transition-all flex items-center gap-2 text-sm md:text-base">
                    <i class="fas fa-wind"></i> เป่าเทียนทั้งหมด
                </button>
                <button id="rekindle-btn" onclick="relightCandles()" class="bg-white/90 text-pink-600 border border-pink-300 font-semibold px-5 py-2.5 rounded-full shadow-sm hover:bg-pink-50 hover:scale-105 transition-all text-sm md:text-base hidden">
                    <i class="fas fa-fire text-amber-500"></i> จุดเทียนอีกครั้ง
                </button>
            </div>
            
            <p id="wish-message" class="text-pink-600 font-medium mt-4 h-6 transition-all duration-500 opacity-0">
                ✨ ขอให้พรทุกประการที่คุณอธิษฐานกลายเป็นจริงนะ! 🎉
            </p>
        </section>

        <!-- SECTION 2: BIRTHDAY DATE & COUNTDOWN -->
        <section class="my-6 glass-card rounded-3xl p-6 md:p-8 shadow-xl text-center">
            <div class="inline-block p-3 bg-pink-100 rounded-full text-pink-500 mb-3">
                <i class="fas fa-calendar-star text-2xl"></i>
            </div>
            <h2 id="counter-title" contenteditable="true" class="text-2xl md:text-3xl font-bold text-gray-800 font-mitr mb-1">🎂 วันเกิดสุดพิเศษ: 9 ตุลาคม</h2>
            <p id="counter-subtitle" contenteditable="true" class="text-sm md:text-base text-gray-500 mb-6">นับถอยหลังเข้าสู่วันเกิดวันที่ 9 ตุลาคม 🎉</p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 max-w-2xl mx-auto">
                <div class="bg-white/90 p-4 rounded-2xl border border-pink-100 shadow-sm">
                    <span id="days-count" class="block text-2xl md:text-4xl font-extrabold text-pink-500 font-mitr">0</span>
                    <span class="text-xs md:text-sm text-gray-500 font-medium">วัน</span>
                </div>
                <div class="bg-white/90 p-4 rounded-2xl border border-pink-100 shadow-sm">
                    <span id="hours-count" class="block text-2xl md:text-4xl font-extrabold text-sky-500 font-mitr">0</span>
                    <span class="text-xs md:text-sm text-gray-500 font-medium">ชั่วโมง</span>
                </div>
                <div class="bg-white/90 p-4 rounded-2xl border border-pink-100 shadow-sm">
                    <span id="minutes-count" class="block text-2xl md:text-4xl font-extrabold text-pink-500 font-mitr">0</span>
                    <span class="text-xs md:text-sm text-gray-500 font-medium">นาที</span>
                </div>
                <div class="bg-white/90 p-4 rounded-2xl border border-pink-100 shadow-sm">
                    <span id="seconds-count" class="block text-2xl md:text-4xl font-extrabold text-sky-500 font-mitr">0</span>
                    <span class="text-xs md:text-sm text-gray-500 font-medium">วินาที</span>
                </div>
            </div>
        </section>

        <!-- SECTION 3: PHOTO GALLERY CAROUSEL -->
        <section class="my-6 glass-card rounded-3xl p-6 md:p-8 shadow-xl">
            <div class="text-center mb-6">
                <h2 class="text-2xl md:text-3xl font-bold text-sky-700 font-mitr">📸 คลังความทรงจำของ dek bank</h2>
                <p class="text-sm text-gray-500">บันทึกรอยยิ้มและความรู้สึกดีๆ (กดปุ่มด้านล่างเพื่อเลือกใส่ 4 รูปของ dek bank ได้เลย!)</p>
            </div>

            <!-- Gallery Carousel Container -->
            <div class="relative max-w-xl mx-auto">
                <div id="gallery-container" class="relative overflow-hidden rounded-2xl shadow-lg aspect-4/3 bg-gray-100 border-4 border-white">
                    <!-- Gallery items loaded via JS -->
                </div>

                <!-- Navigation Buttons -->
                <button onclick="prevSlide()" class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-pink-500 p-3 rounded-full shadow-md transition-all hover:scale-110">
                    <i class="fas fa-chevron-left text-lg"></i>
                </button>
                <button onclick="nextSlide()" class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-pink-500 p-3 rounded-full shadow-md transition-all hover:scale-110">
                    <i class="fas fa-chevron-right text-lg"></i>
                </button>

                <!-- Carousel Dots -->
                <div id="gallery-dots" class="flex justify-center gap-2 mt-4">
                    <!-- Dots generated via JS -->
                </div>

                <!-- Direct Upload Button for dek bank's 4 Photos -->
                <div class="mt-5 flex flex-col items-center justify-center gap-2">
                    <label class="cursor-pointer bg-gradient-to-r from-pink-500 via-rosePink to-sky-500 hover:from-pink-600 hover:to-sky-600 text-white font-semibold px-6 py-2.5 rounded-full shadow-lg hover:shadow-pink-300/80 hover:scale-105 active:scale-95 transition-all text-sm flex items-center gap-2">
                        <i class="fas fa-images text-lg"></i>
                        <span>เลือกรูปภาพจากเครื่อง (ใส่ 4 รูปของ dek bank)</span>
                        <input type="file" id="gallery-file-input" accept="image/*" multiple class="hidden" onchange="handleImageUpload(event)">
                    </label>
                    <span class="text-xs text-gray-500">💡 กดปุ่มเพื่อเลือกรูปทั้ง 4 รูปพร้อมกันได้เลยครับ</span>
                </div>
            </div>
        </section>

        <!-- SECTION 4: FLIP WISH CARDS -->
        <section class="my-6 glass-card rounded-3xl p-6 md:p-8 shadow-xl">
            <div class="text-center mb-6">
                <h2 class="text-2xl md:text-3xl font-bold text-pink-600 font-mitr">💌 คำอวยพรจากใจ</h2>
                <p class="text-sm text-gray-500">คลิกที่การ์ดเพื่อเปิดอ่านข้อความความในใจ</p>
            </div>

            <div id="wish-cards-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="perspective-1000 h-64 cursor-pointer" onclick="toggleFlipCard(this)">
                    <div class="card-inner relative w-full h-full transform-style-3d shadow-lg rounded-2xl">
                        <!-- Front -->
                        <div class="absolute inset-0 bg-gradient-to-br from-pink-300 to-rosePink text-white rounded-2xl p-6 flex flex-col items-center justify-center text-center backface-hidden border-2 border-white/60">
                            <span class="text-4xl mb-3">🌟</span>
                            <h3 class="font-bold text-xl mb-1 font-mitr">การ์ดใบที่ 1</h3>
                            <p class="text-xs text-pink-100">คลิกเพื่อเปิดอ่าน ✨</p>
                        </div>
                        <!-- Back -->
                        <div class="absolute inset-0 bg-white rounded-2xl p-6 flex flex-col justify-between text-center rotate-y-180 backface-hidden border-2 border-pink-200">
                            <i class="fas fa-quote-left text-pink-300 text-xl text-left"></i>
                            <p id="card-msg-1" contenteditable="true" class="text-gray-700 text-sm md:text-base font-medium leading-relaxed">ขอให้ปีนี้เป็นปีที่ใจดีกับเธอมากๆ มีแต่ความสุขและเสียงหัวเราะนะ!</p>
                            <i class="fas fa-quote-right text-pink-300 text-xl text-right"></i>
                        </div>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="perspective-1000 h-64 cursor-pointer" onclick="toggleFlipCard(this)">
                    <div class="card-inner relative w-full h-full transform-style-3d shadow-lg rounded-2xl">
                        <!-- Front -->
                        <div class="absolute inset-0 bg-gradient-to-br from-sky-300 to-amber-300 text-white rounded-2xl p-6 flex flex-col items-center justify-center text-center backface-hidden border-2 border-white/60">
                            <span class="text-4xl mb-3">💖</span>
                            <h3 class="font-bold text-xl mb-1 font-mitr">การ์ดใบที่ 2</h3>
                            <p class="text-xs text-sky-50">คลิกเพื่อเปิดอ่าน ✨</p>
                        </div>
                        <!-- Back -->
                        <div class="absolute inset-0 bg-white rounded-2xl p-6 flex flex-col justify-between text-center rotate-y-180 backface-hidden border-2 border-sky-200">
                            <i class="fas fa-quote-left text-sky-300 text-xl text-left"></i>
                            <p id="card-msg-2" contenteditable="true" class="text-gray-700 text-sm md:text-base font-medium leading-relaxed">ขอบคุณที่เป็นความสดใสในทุกๆ วัน ดีใจมากๆ ที่มีเธออยู่ในชีวิตนะ</p>
                            <i class="fas fa-quote-right text-sky-300 text-xl text-right"></i>
                        </div>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="perspective-1000 h-64 cursor-pointer" onclick="toggleFlipCard(this)">
                    <div class="card-inner relative w-full h-full transform-style-3d shadow-lg rounded-2xl">
                        <!-- Front -->
                        <div class="absolute inset-0 bg-gradient-to-br from-pink-300 to-sky-300 text-white rounded-2xl p-6 flex flex-col items-center justify-center text-center backface-hidden border-2 border-white/60">
